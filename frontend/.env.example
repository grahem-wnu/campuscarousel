# Frontend runtime configuration (Vite reads VITE_* at build time).
# Copy to `.env.local` for local dev. CI/CD injects these from SSM
# (/keiras-journey/<env>/...) at build — never commit real values.
# These are public by design (Cognito app client has no secret).

VITE_AWS_REGION=us-east-2
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_API_BASE_URL=

{
  "app": "npx ts-node --prefer-ts-exts bin/infra.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "dist"
    ]
  },
  "context": {
    "project": "keiras-journey",
    "githubOrg": "grahem-wnu",
    "githubRepo": "keiras-journey",
    "domainName": "campuscarousel.com",
    "bedrockSonnetProfile": "us.anthropic.claude-sonnet-4-6",
    "monthlyBudgetUsd": 75,
    "_alertEmailNote": "Subscribed to the per-env CloudWatch alarm SNS topic AND the account budget alarm. SNS sends a one-time confirmation email that must be clicked. Change/remove to reroute ops alerts.",
    "alertEmail": "grahem@weneedushealth.com",
    "_domainNote": "Everything runs on campuscarousel.com (zone Z026658226B9KAOVTOAIH): staging → staging.campuscarousel.com, prod → campuscarousel.com (apex). keirasjourney.com (zone Z03683613MXDVX9D5VIUV) is PARKED — no longer used by the app. The legacy single-tenant prod stack still serves keirasjourney.com until it's retired after the data migration; do not point new infra at it. Zones imported (dnsMode import) so NS delegation stays intact.",
    "hostedZoneId": "Z026658226B9KAOVTOAIH",
    "envs": {
      "staging": {
        "stage": "staging",
        "dnsMode": "import",
        "domainName": "campuscarousel.com",
        "hostedZoneId": "Z026658226B9KAOVTOAIH",
        "subdomain": "staging",
        "reminderSenderEmail": "noreply@campuscarousel.com",
        "removalPolicy": "destroy"
      },
      "prod": {
        "stage": "prod",
        "dnsMode": "import",
        "domainName": "campuscarousel.com",
        "hostedZoneId": "Z026658226B9KAOVTOAIH",
        "subdomain": "",
        "reminderSenderEmail": "noreply@campuscarousel.com",
        "removalPolicy": "retain"
      }
    },
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-sns-subscriptions:restrictSqsDescryption": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/aws-lambda:useCdkManagedLogGroup": false
  }
}
